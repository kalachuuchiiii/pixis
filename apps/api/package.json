{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "build": "nest build",
    "build:prod": "npx @nestjs/cli build",
    "typeorm": "node -r ts-node/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d ./src/dataSource.ts ./src/migrations",
    "migration:run": "pnpm typeorm migration:run -d ./src/dataSource.ts",
    "migration:revert": "pnpm typeorm migration:revert -d ./src/dataSource.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.48",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@pixis/constants": "workspace:*",
    "@pixis/schemas": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.3.5",
    "langchain": "^1.4.2",
    "ms": "^2.1.3",
    "multer": "^2.1.1",
    "nest-winston": "^1.10.2",
    "nestjs-paginate": "^13.2.0",
    "nestql": "^1.1.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
