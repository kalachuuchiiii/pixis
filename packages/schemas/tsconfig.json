{
  "compilerOptions": {
    "outDir": "dist",
    "target": "ES2022",
    "rootDir": "./src",
    "strictNullChecks": true,
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
